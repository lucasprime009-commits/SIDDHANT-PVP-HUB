-- Clamp any GuiObject cleanly inside the current viewport
local function clampFrameToViewport(frame: GuiObject?): UDim2?
	if not frame then
		return nil
	end
	local cam = getActiveCamera()
	if not cam then
		return frame.Position
	end

	local viewport = cam.ViewportSize
	local absPos = frame.AbsolutePosition
	local absSize = frame.AbsoluteSize
	if viewport.X <= 0 or viewport.Y <= 0 or absSize.X <= 0 or absSize.Y <= 0 then
		return frame.Position
	end

	local clampedX = math.clamp(absPos.X, 4, math.max(4, viewport.X - absSize.X - 4))
	local clampedY = math.clamp(absPos.Y, 4, math.max(4, viewport.Y - absSize.Y - 4))
	local newPos = UDim2.fromOffset(clampedX, clampedY)
	frame.Position = newPos
	return newPos
end


-- Tap-on-Player to Lock (movement-gated so camera drags never trigger it) & Keyboard Controls
local tapCandidateInput: InputObject? = nil
local tapCandidateStartPos = Vector2.zero
local tapCandidateMoved = false

UserInputService.InputBegan:Connect(function(input: InputObject, gameProcessed: boolean)
	if awaitingRebind and input.UserInputType == Enum.UserInputType.Keyboard then
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			CONFIG.ToggleKey = input.KeyCode
			saveSessionSettings()
		end
		awaitingRebind = false
		syncAllUI()
		return
	end

	if gameProcessed then
		return
	end

	if CONFIG.TapToLock and tapCandidateInput == nil and (input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1) then
		tapCandidateInput = input
		tapCandidateStartPos = Vector2.new(input.Position.X, input.Position.Y)
		tapCandidateMoved = false
	end

	if input.KeyCode == CONFIG.ToggleKey then
		toggleFlight()
	elseif input.KeyCode == CONFIG.DashKey then
		triggerAirDash()
	elseif input.KeyCode == AIM_CONFIG.ToggleKey then
		toggleAimbot()
	elseif input.KeyCode == DEFAULTS.ComboKey then
		runPvPCombo()
	end
end)

UserInputService.InputChanged:Connect(function(input: InputObject)
	if input == tapCandidateInput then
		local delta = Vector2.new(input.Position.X, input.Position.Y) - tapCandidateStartPos
		if delta.Magnitude > CONFIG.DragThresholdPixels then
			tapCandidateMoved = true
		end
	end
end)

UserInputService.InputEnded:Connect(function(input: InputObject)
	if input == tapCandidateInput then
		local wasCleanTap = not tapCandidateMoved
		tapCandidateInput = nil
		tapCandidateMoved = false

		if wasCleanTap and CONFIG.TapToLock then
			local cam = getActiveCamera()
			if cam then
				local ray = cam:ScreenPointToRay(input.Position.X, input.Position.Y)
				if player.Character then
					tapLockRayParams.FilterDescendantsInstances = { player.Character }
				end
				local hit = workspace:Raycast(ray.Origin, ray.Direction * 1000, tapLockRayParams)
				if hit and hit.Instance then
					local hitModel = hit.Instance:FindFirstAncestorOfClass("Model")
					local hitPlayer = hitModel and Players:GetPlayerFromCharacter(hitModel)
					if hitPlayer and hitPlayer ~= player then
						local isEnemy = not (AIM_CONFIG.TeamCheck and player.Team ~= nil and hitPlayer.Team == player.Team)
						if isEnemy then
							manualPriorityTarget = hitPlayer
							syncAllUI()
						end
					end
				end
			end
		end
	end
end)


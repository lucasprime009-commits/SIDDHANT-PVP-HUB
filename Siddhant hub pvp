local function getGamepadInput(): (Vector2, number)
	if not UserInputService.GamepadEnabled then
		return Vector2.zero, 0
	end

	local stick = Vector2.zero
	local vertical = 0

	for _, inputObj in ipairs(UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)) do
		if inputObj.KeyCode == Enum.KeyCode.Thumbstick1 then
			local pos = inputObj.Position
			if pos.Magnitude > 0.15 then
				stick = Vector2.new(pos.X, pos.Y)
			end
		end
	end

	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonA) then
		vertical += 1
	end
	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonB) then
		vertical -= 1
	end

	return stick, vertical
end

local function getDesiredMovement(humanoid: Humanoid): (Vector3, number, boolean)
	local cam = getActiveCamera()
	if not cam then
		return Vector3.zero, 0, false
	end

	local braking = UserInputService:IsKeyDown(CONFIG.BrakeKey)
	if braking then
		return Vector3.zero, 0, true
	end

	local forward = 0
	local right = 0
	local up = 0

	if UserInputService:IsKeyDown(Enum.KeyCode.W) then
		forward += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.S) then
		forward -= 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.D) then
		right += 1
	end
	if UserInputService:IsKeyDown(Enum.KeyCode.A) then
		right -= 1
	end
	if UserInputService:IsKeyDown(CONFIG.AscendKey) then
		up += 1
	end
	if UserInputService:IsKeyDown(CONFIG.DescendKey) then
		up -= 1
	end

	local padStick, padUp = getGamepadInput()
	right += padStick.X
	forward += padStick.Y
	up += padUp

	local mobileMove = humanoid.MoveDirection
	if mobileMove.Magnitude > 0.05 then
		local camLookXZ = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		local camRightXZ = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
		if camLookXZ.Magnitude > 1e-4 then
			camLookXZ = camLookXZ.Unit
		end
		if camRightXZ.Magnitude > 1e-4 then
			camRightXZ = camRightXZ.Unit
		end
		forward += mobileMove:Dot(camLookXZ)
		right += mobileMove:Dot(camRightXZ)
	end

	forward = math.clamp(forward, -1, 1)
	right = math.clamp(right, -1, 1)
	up = math.clamp(up, -1, 1)

	local forwardAxis = cam.CFrame.LookVector
	local rightFlat = Vector3.new(cam.CFrame.RightVector.X, 0, cam.CFrame.RightVector.Z)
	local rightAxis = rightFlat.Magnitude > 1e-4 and rightFlat.Unit or Vector3.zero

	local direction = (forwardAxis * forward) + (rightAxis * right) + (Vector3.yAxis * up)
	if direction.Magnitude > 1 then
		direction = direction.Unit
	end

	return direction, right, false
end

local function computeFlightOrientation(position: Vector3, targetDir: Vector3, strafeAmount: number, cam: Camera?): CFrame?
	local bankRad = math.rad(-strafeAmount * CONFIG.MaxBankAngleDeg)

	if targetDir.Magnitude > 0.05 then
		local horizontalDir = Vector3.new(targetDir.X, 0, targetDir.Z)
		local yawForward: Vector3
		if horizontalDir.Magnitude > 0.08 then
			yawForward = horizontalDir.Unit
		elseif cam then
			local camFlat = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
			yawForward = camFlat.Magnitude > 1e-4 and camFlat.Unit or Vector3.new(0, 0, -1)
		else
			yawForward = Vector3.new(0, 0, -1)
		end

		local yawFrame = CFrame.lookAt(position, position + yawForward)
		local pitchAngle = math.asin(math.clamp(targetDir.Y, -0.92, 0.92))
		return yawFrame * CFrame.Angles(pitchAngle, 0, bankRad)
	elseif cam then
		local flatLook = Vector3.new(cam.CFrame.LookVector.X, 0, cam.CFrame.LookVector.Z)
		if flatLook.Magnitude > 1e-4 then
			return CFrame.lookAt(position, position + flatLook.Unit)
		end
	end

	return nil
end

local function getAltitudeAboveGround(character: Model, rootPart: BasePart): number
	rayParams.FilterDescendantsInstances = { character }
	local hit = workspace:Raycast(rootPart.Position, Vector3.new(0, -1000, 0), rayParams)
	if hit then
		return math.max(0, rootPart.Position.Y - hit.Position.Y)
	end
	return math.max(0, rootPart.Position.Y)
end


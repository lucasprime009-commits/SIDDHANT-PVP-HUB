local function hopToFreshServer()
	if hoppingServer then
		return
	end
	hoppingServer = true

	task.spawn(function()
		local placeId = game.PlaceId
		local currentJobId = game.JobId
		local chosenServerId: string? = nil

		local rawJson = fetchPublicServersJSON(placeId)
		if rawJson then
			local ok, decoded = pcall(function()
				return HttpService:JSONDecode(rawJson)
			end)
			if ok and typeof(decoded) == "table" and typeof(decoded.data) == "table" then
				for _, server in ipairs(decoded.data) do
					if typeof(server) == "table" and server.id and server.id ~= currentJobId then
						local playing = tonumber(server.playing) or 0
						local maxPlayers = tonumber(server.maxPlayers) or 12
						if playing >= 1 and playing < (maxPlayers - 1) then
							chosenServerId = tostring(server.id)
							break
						end
					end
				end
			end
		end

		pcall(function()
			if chosenServerId then
				TeleportService:TeleportToPlaceInstance(placeId, chosenServerId, player)
			else
				TeleportService:Teleport(placeId, player)
			end
		end)

		task.wait(4)
		hoppingServer = false
	end)
end


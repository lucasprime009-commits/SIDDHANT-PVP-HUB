local function equipToolByCategory(category: string): Tool?
	local char = player.Character
	local humanoid = char and char:FindFirstChildOfClass("Humanoid")
	local backpack = player:FindFirstChildOfClass("Backpack")
	if not char or not humanoid or not backpack then
		return nil
	end

	for _, item in ipairs(char:GetChildren()) do
		if item:IsA("Tool") then
			local tip = item.ToolTip
			if tip == category or string.find(string.lower(tip), string.lower(category), 1, true) then
				return item
			end
		end
	end

	for _, item in ipairs(backpack:GetChildren()) do
		if item:IsA("Tool") then
			local tip = item.ToolTip
			if tip == category or string.find(string.lower(tip), string.lower(category), 1, true) then
				humanoid:EquipTool(item)
				return item
			end
		end
	end

	return nil
end

-- Blox Fruits PvP Status & Target Validation
local function isTargetPvPEligible(targetPlayer: Player, targetChar: Model): boolean
	if not AIM_CONFIG.PvPStatusCheck then
		return true
	end
	if targetChar:FindFirstChildOfClass("ForceField") then
		return false
	end
	local pvpFlag = targetPlayer:FindFirstChild("PvPDisabled") or targetChar:FindFirstChild("PvPDisabled")
	if pvpFlag and pvpFlag:IsA("BoolValue") and pvpFlag.Value == true then
		return false
	end
	local safeZoneFlag = targetPlayer:FindFirstChild("SafeZone") or targetChar:FindFirstChild("SafeZone")
	if safeZoneFlag and safeZoneFlag:IsA("BoolValue") and safeZoneFlag.Value == true then
		return false
	end
	return true
end

local function validateTargetPlayer(targetPlayer: Player?, cam: Camera, ignoreWallCheck: boolean?): (boolean, BasePart?, Humanoid?, number)
	if not targetPlayer or targetPlayer == player or not targetPlayer.Parent then
		return false, nil, nil, math.huge
	end

	if AIM_CONFIG.TeamCheck and player.Team ~= nil and targetPlayer.Team == player.Team then
		return false, nil, nil, math.huge
	end

	local char = targetPlayer.Character
	if not char or not isTargetPvPEligible(targetPlayer, char) then
		return false, nil, nil, math.huge
	end

	local hum = char:FindFirstChildOfClass("Humanoid")
	if not hum or hum.Health <= 0 or hum:GetState() == Enum.HumanoidStateType.Dead then
		return false, nil, nil, math.huge
	end

	local part = (char:FindFirstChild(AIM_CONFIG.TargetPartName) :: BasePart?)
		or (char:FindFirstChild(AIM_CONFIG.FallbackPartName) :: BasePart?)
	if not part then
		return false, nil, nil, math.huge
	end

	local dist = (part.Position - cam.CFrame.Position).Magnitude
	if dist > AIM_CONFIG.MaxDistance then
		return false, nil, nil, dist
	end

	if AIM_CONFIG.VisibilityCheck and not ignoreWallCheck then
		local excludeList: { Instance } = { char }
		if player.Character then
			table.insert(excludeList, player.Character)
		end
		aimRayParams.FilterDescendantsInstances = excludeList

		local origin = cam.CFrame.Position
		local direction = part.Position - origin
		local hit = workspace:Raycast(origin, direction, aimRayParams)
		if hit and not hit.Instance:IsDescendantOf(char) then
			return false, nil, nil, dist
		end
	end

	return true, part, hum, dist
end

local function findBestAimTarget(cam: Camera): (Player?, BasePart?, Humanoid?, Vector2?, number)
	local screenCenter = Vector2.new(cam.ViewportSize.X * 0.5, cam.ViewportSize.Y * 0.5)

	-- 0. Manual Priority Target (auto-clears when invalid, dead, safe-zoned, or out of range)
	if manualPriorityTarget then
		local valid, part, hum, dist = validateTargetPlayer(manualPriorityTarget, cam, true)
		if not valid or not part or not hum then
			manualPriorityTarget = nil
			if refreshMenuUI then
				task.defer(refreshMenuUI)
			end
		else
			local predictedPos = part.Position + (part.AssemblyLinearVelocity * AIM_CONFIG.LeadPrediction)
			local screenPoint, onScreen = cam:WorldToViewportPoint(predictedPos)
			if onScreen and screenPoint.Z > 0 then
				return manualPriorityTarget, part, hum, Vector2.new(screenPoint.X, screenPoint.Y), dist
			end
		end
	end

	-- 1. Sticky Lock Check
	if lockedTargetPlayer then
		local valid, part, hum, dist = validateTargetPlayer(lockedTargetPlayer, cam, false)
		if valid and part and hum then
			local predictedPos = part.Position + (part.AssemblyLinearVelocity * AIM_CONFIG.LeadPrediction)
			local screenPoint, onScreen = cam:WorldToViewportPoint(predictedPos)
			if onScreen and screenPoint.Z > 0 then
				local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
				local distFromCenter = (screenPos2D - screenCenter).Magnitude
				if distFromCenter <= (AIM_CONFIG.AimFOVRadius + AIM_CONFIG.StickyLockBonusPixels) then
					return lockedTargetPlayer, part, hum, screenPos2D, dist
				end
			end
		end
	end

	-- 2. Acquire closest target to screen center inside AimFOVRadius
	local bestPlayer: Player? = nil
	local bestPart: BasePart? = nil
	local bestHum: Humanoid? = nil
	local bestScreenPos: Vector2? = nil
	local bestWorldDist = 0
	local bestDistToCenter = AIM_CONFIG.AimFOVRadius

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		local valid, targetPart, targetHum, worldDist = validateTargetPlayer(otherPlayer, cam, false)
		if valid and targetPart and targetHum then
			local predictedPos = targetPart.Position + (targetPart.AssemblyLinearVelocity * AIM_CONFIG.LeadPrediction)
			local screenPoint, onScreen = cam:WorldToViewportPoint(predictedPos)
			if onScreen and screenPoint.Z > 0 then
				local screenPos2D = Vector2.new(screenPoint.X, screenPoint.Y)
				local distFromCenter = (screenPos2D - screenCenter).Magnitude
				if distFromCenter <= bestDistToCenter then
					bestDistToCenter = distFromCenter
					bestPlayer = otherPlayer
					bestPart = targetPart
					bestHum = targetHum
					bestScreenPos = screenPos2D
					bestWorldDist = worldDist
				end
			end
		end
	end

	return bestPlayer, bestPart, bestHum, bestScreenPos, bestWorldDist
end

-- Player ESP with Visual Color-Shifting HP Bars & PvP Status Badges
local function clearPlayerESP(targetPlayer: Player)
	local entry = espObjects[targetPlayer]
	if entry then
		if entry.highlight then
			entry.highlight:Destroy()
		end
		if entry.billboard then
			entry.billboard:Destroy()
		end
		espObjects[targetPlayer] = nil
	end
end

local function clearAllESP()
	for targetPlayer in pairs(espObjects) do
		clearPlayerESP(targetPlayer)
	end
end

local function updateESPSystem(cam: Camera)
	if not CONFIG.ESPEnabled then
		clearAllESP()
		return
	end

	local theme = getTheme()

	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer == player then
			continue
		end

		local char = otherPlayer.Character
		local hum = char and char:FindFirstChildOfClass("Humanoid")
		local head = char and (char:FindFirstChild("Head") :: BasePart?)
		local isEnemy = not (AIM_CONFIG.TeamCheck and player.Team ~= nil and otherPlayer.Team == player.Team)

		if not char or not hum or hum.Health <= 0 or not head or not isEnemy then
			clearPlayerESP(otherPlayer)
			continue
		end

		local dist = (head.Position - cam.CFrame.Position).Magnitude
		if dist > 1500 then
			clearPlayerESP(otherPlayer)
			continue
		end

		local entry = espObjects[otherPlayer]
		if not entry or not entry.highlight or entry.highlight.Parent ~= char then
			clearPlayerESP(otherPlayer)

			local hl = Instance.new("Highlight")
			hl.Name = "SiddhantPvPESP"
			hl.Adornee = char
			hl.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
			hl.FillTransparency = 0.72
			hl.OutlineTransparency = 0.1

-- Noclip state management
local function setNoclipEnabled(enabled: boolean)
	if descendantAddedConn then
		descendantAddedConn:Disconnect()
		descendantAddedConn = nil
	end

	local character = player.Character
	if not enabled or not flying or not character then
		for part, wasCollidable in pairs(originalCollisions) do
			if part and part.Parent then
				part.CanCollide = wasCollidable
			end
		end
		table.clear(originalCollisions)
		return
	end

	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA("BasePart") then
			if originalCollisions[descendant] == nil then
				originalCollisions[descendant] = descendant.CanCollide
			end
			descendant.CanCollide = false
		end
	end

	descendantAddedConn = character.DescendantAdded:Connect(function(descendant: Instance)
		if flying and CONFIG.NoclipWhileFlying and descendant:IsA("BasePart") then
			if originalCollisions[descendant] == nil then
				originalCollisions[descendant] = descendant.CanCollide
			end
			descendant.CanCollide = false
		end
	end)
end


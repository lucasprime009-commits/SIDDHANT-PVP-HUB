	linearVelocity = lv

	local ao = Instance.new("AlignOrientation")
	ao.Name = "FlightAlignOrientation"
	ao.Attachment0 = attachment
	ao.Mode = Enum.OrientationAlignmentMode.OneAttachment
	ao.MaxTorque = CONFIG.MaxForce
	ao.Responsiveness = CONFIG.Responsiveness
	ao.CFrame = rootPart.CFrame
	ao.Parent = rootPart
	alignOrientation = ao

	heartbeatConn = RunService.Heartbeat:Connect(function(dt: number)
		if not flying then
			return
		end

		local currentHumanoid, currentRoot = getCharacterParts(player.Character)
		if not currentHumanoid or not currentRoot or currentHumanoid.Health <= 0 or not linearVelocity or not alignOrientation then
			stopFlight()
			return
		end

		local activeCam = getActiveCamera()
		local targetDir, strafeAmount, braking = getDesiredMovement(currentHumanoid)

		if not CONFIG.NoclipWhileFlying then
			local descending = UserInputService:IsKeyDown(CONFIG.DescendKey) or targetDir.Y < -0.45
			if descending and player.Character then
				local groundDist = getAltitudeAboveGround(player.Character, currentRoot)
				if groundDist <= CONFIG.AutoLandDistance then
					stopFlight()
					return
				end
			end
		end

		local now = os.clock()
		local isDashing = now < dashEndTime
		local sprinting = touchSprinting
			or UserInputService:IsKeyDown(Enum.KeyCode.LeftShift)
			or UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL3)

		local effectiveDir = targetDir
		local speed = CONFIG.FlySpeed * (sprinting and CONFIG.SprintMultiplier or 1)

		if isDashing then
			speed = CONFIG.DashSpeed
			if effectiveDir.Magnitude < 0.05 and activeCam then
				effectiveDir = activeCam.CFrame.LookVector
			end
		end

		local targetVelocity = effectiveDir * speed

		if not braking and effectiveDir.Magnitude < 0.05 then
			hoverTime += dt
			targetVelocity += Vector3.new(0, math.sin(hoverTime * 2.6) * 1.15, 0)
		else
			hoverTime = 0
		end

		local accelRate = if braking then CONFIG.BrakeDeceleration elseif isDashing then 28 else CONFIG.Acceleration
		local alpha = math.clamp(1 - math.exp(-accelRate * dt), 0, 1)
		moveInput = moveInput:Lerp(targetVelocity, alpha)
		linearVelocity.VectorVelocity = moveInput

		local currentSpeed = moveInput.Magnitude

		if activeCam then
			if baseFOV == nil then
				baseFOV = activeCam.FieldOfView
			end
			local boost = if isDashing then (CONFIG.SprintFOVBoost * 1.5)
				elseif (sprinting and effectiveDir.Magnitude > 0.1) then CONFIG.SprintFOVBoost
				else 0
			local desiredFOV = baseFOV + boost
			activeCam.FieldOfView += (desiredFOV - activeCam.FieldOfView) * math.clamp(8 * dt, 0, 1)
		end

		local targetRoll = math.rad(-strafeAmount * CONFIG.MaxCameraRollDeg)
		currentCameraRoll += (targetRoll - currentCameraRoll) * math.clamp(8 * dt, 0, 1)

		if windParticles then
			windParticles.Rate = math.clamp(12 + (currentSpeed * 0.45), 10, 90)
		end
		if windSound then
			local speedRatio = math.clamp(currentSpeed / math.max(1, CONFIG.FlySpeed * CONFIG.SprintMultiplier), 0, 1.5)
			windSound.Volume = 0.04 + (speedRatio * 0.28)
			windSound.PlaybackSpeed = 0.8 + (speedRatio * 0.55)
		end

		if dashChipBtn then
			local remaining = math.max(0, CONFIG.DashCooldown - (now - lastDashTime))
			if remaining > 0 then
				dashChipBtn.Text = string.format("DASH %.1fs", remaining)
				dashChipBtn.BackgroundColor3 = Color3.fromRGB(39, 46, 61)
			else
				dashChipBtn.Text = "⚡ DASH"
				dashChipBtn.BackgroundColor3 = getTheme().primary
			end
		end

		if telemetryLabel and player.Character then
			local alt = getAltitudeAboveGround(player.Character, currentRoot)
			telemetryLabel.Text = string.format("SPD: %d st/s   |   ALT: %d st", math.floor(currentSpeed + 0.5), math.floor(alt + 0.5))
		end

		local desiredCFrame = computeFlightOrientation(currentRoot.Position, effectiveDir, strafeAmount, activeCam)
		if desiredCFrame then
			local rotAlpha = math.clamp((effectiveDir.Magnitude > 0.05 and 10 or 8) * dt, 0, 1)
			alignOrientation.CFrame = alignOrientation.CFrame:Lerp(desiredCFrame, rotAlpha)
		end
	end)
end

-- Wall/Ground-Safe Orbit Position Helper
local function getSafeOrbitPosition(targetChar: Model, targetRoot: BasePart, desiredPos: Vector3): Vector3
	local excludeList: { Instance } = { targetChar }
	if player.Character then
		table.insert(excludeList, player.Character)
	end
	orbitRayParams.FilterDescendantsInstances = excludeList

	local origin = targetRoot.Position
	local delta = desiredPos - origin
	if delta.Magnitude < 0.1 then
		return desiredPos
	end

	local hit = workspace:Raycast(origin, delta, orbitRayParams)
	if hit then
		return hit.Position - (delta.Unit * 2.5)
	end
	return desiredPos
end

-- Passive Survivability & Wall-Safe Target Orbit Loop
local function startPassiveSurvivabilityLoop()
	if passiveUtilityConn then
		passiveUtilityConn:Disconnect()
	end

	waterRayParams.FilterDescendantsInstances = { workspace.Terrain }

	passiveUtilityConn = RunService.Heartbeat:Connect(function(dt: number)
		local hum, rootPart = getCharacterParts(player.Character)
		if not hum or not rootPart or hum.Health <= 0 then
			return
		end

		-- 1. Auto Low-HP Escape
		if CONFIG.AutoEscapeEnabled then
			local hpPct = (hum.Health / math.max(1, hum.MaxHealth)) * 100
			if hpPct <= CONFIG.EscapeHPPercent and not escapeTriggered then
				escapeTriggered = true
				comboRunning = false
				if not flying then
					startFlight()
				end
				local escapePos = rootPart.Position + Vector3.new(0, 180, 0)
				rootPart.CFrame = CFrame.new(escapePos)
				moveInput = Vector3.new(0, 60, 0)
				if alignOrientation then
					alignOrientation.CFrame = CFrame.new(escapePos)
				end
			elseif hpPct > (CONFIG.EscapeHPPercent + 15) then
				escapeTriggered = false
			end
		end

		-- 2. Wall-Safe Target Orbit / Strafe Assist when Aiming or Comboing
		local activeTarget = manualPriorityTarget or lockedTargetPlayer
		if CONFIG.OrbitTarget and (aimbotActive or comboRunning) and activeTarget and activeTarget.Character then
			local targetRoot = activeTarget.Character:FindFirstChild("HumanoidRootPart") :: BasePart?
			if targetRoot and (targetRoot.Position - rootPart.Position).Magnitude <= 140 then
				orbitAngle = (orbitAngle + (CONFIG.OrbitAngularSpeed * dt)) % (math.pi * 2)
				local rawOffset = Vector3.new(math.cos(orbitAngle) * CONFIG.OrbitRadius, 4, math.sin(orbitAngle) * CONFIG.OrbitRadius)
				local safePos = getSafeOrbitPosition(activeTarget.Character, targetRoot, targetRoot.Position + rawOffset)
				local lookAtTarget = CFrame.lookAt(safePos, Vector3.new(targetRoot.Position.X, safePos.Y, targetRoot.Position.Z))
				rootPart.CFrame = rootPart.CFrame:Lerp(lookAtTarget, math.clamp(12 * dt, 0, 1))
				if alignOrientation then
					alignOrientation.CFrame = lookAtTarget
				end
			end
		end

		-- 3. Anti-Knockback / Velocity Stabilizer
		if CONFIG.AntiKnockback and not flying then
			local vel = rootPart.AssemblyLinearVelocity
			if vel.Magnitude > CONFIG.MaxKnockbackSpeed then
				rootPart.AssemblyLinearVelocity = vel.Unit * (CONFIG.MaxKnockbackSpeed * 0.45)
			end
		end

		-- 4. Walk-on-Water / Sea-Surface Hover
		if CONFIG.WalkOnWater and not flying then
			local waterHit = workspace:Raycast(rootPart.Position + Vector3.new(0, 3, 0), Vector3.new(0, -8.5, 0), waterRayParams)
			if waterHit and waterHit.Material == Enum.Material.Water then
				local minAllowedY = waterHit.Position.Y + 2.85
				if rootPart.Position.Y < minAllowedY then
					local vel = rootPart.AssemblyLinearVelocity
					rootPart.CFrame = CFrame.new(rootPart.Position.X, minAllowedY, rootPart.Position.Z) * rootPart.CFrame.Rotation
					if vel.Y < 0 then
						rootPart.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
					end
				end
			end
		end

		-- 5. Auto-Ken (Observation Haki) Cooldown Re-Trigger
		if CONFIG.AutoKenEnabled and (isAimingEngaged() or comboRunning) then
			local now = os.clock()
			if (now - lastAutoKenTime) >= 8.5 then
				lastAutoKenTime = now
				toggleInstinctKen()
			end
		end
	end)
end

local function toggleFlight()
	local now = os.clock()
	if (now - lastToggleTime) < CONFIG.ToggleDebounceSeconds then
		return
	end
	lastToggleTime = now

	if flying then
		stopFlight()
	else
		startFlight()
	end
end

local function teleportToWaypoint(slot: number)
	local targetCF = waypoints[slot]
	if not targetCF then
		return
	end
	local _, rootPart = getCharacterParts(player.Character)
	if not rootPart then
		return
	end
	if not flying then
		startFlight()
	end
	moveInput = Vector3.zero
	rootPart.CFrame = targetCF
	if alignOrientation then
		alignOrientation.CFrame = targetCF
	end
end

-- Unified RenderStep bound after Roblox's CameraModule (with 0.10s ESP throttle)
local function bindUnifiedCameraLoop()
	pcall(function()
		RunService:UnbindFromRenderStep(CAMERA_STEP_BIND)
	end)

	RunService:BindToRenderStep(CAMERA_STEP_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt: number)
		local cam = getActiveCamera()
		local engaged = isAimingEngaged()
		local now = os.clock()

		if cam and (now - lastESPUpdateTime) >= 0.10 then
			lastESPUpdateTime = now
			updateESPSystem(cam)
		end

		if fovCircleFrame then
			fovCircleFrame.Visible = AIM_CONFIG.ShowFOVCircle and engaged
			local diameter = AIM_CONFIG.AimFOVRadius * 2
			fovCircleFrame.Size = UDim2.fromOffset(diameter, diameter)
			if fovCircleStroke then
				fovCircleStroke.Color = getTheme().bright
			end
		end

		if cam and engaged then
			local bestPlayer, bestPart, bestHum, bestScreenPos, worldDist = findBestAimTarget(cam)
			lockedTargetPlayer = bestPlayer

			if bestPlayer and bestPart and bestHum and bestScreenPos then
				if lockIndicatorFrame then
					lockIndicatorFrame.Visible = true
					lockIndicatorFrame.Position = UDim2.fromOffset(bestScreenPos.X, bestScreenPos.Y)
				end
				if lockInfoLabel then
					lockInfoLabel.Text = string.format(
						"%s\n%d HP • %d st",
						bestPlayer.DisplayName,
						math.ceil(bestHum.Health),
						math.floor(worldDist + 0.5)
					)
				end

				local aimPoint = bestPart.Position + (bestPart.AssemblyLinearVelocity * AIM_CONFIG.LeadPrediction)
				local desiredLookCF = CFrame.lookAt(cam.CFrame.Position, aimPoint)
				local alpha = math.clamp(1 - math.exp(-AIM_CONFIG.Smoothness * dt), 0, 1)
				cam.CFrame = cam.CFrame:Lerp(desiredLookCF, alpha)
			else
				if lockIndicatorFrame then
					lockIndicatorFrame.Visible = false
				end
			end
		else
			lockedTargetPlayer = nil
			if lockIndicatorFrame then
				lockIndicatorFrame.Visible = false
			end
		end

		if flying and cam and math.abs(currentCameraRoll) > 1e-4 then
			cam.CFrame = cam.CFrame * CFrame.Angles(0, 0, currentCameraRoll)
		end
	end)
end

-- Screen-clamped draggable helper
local function makeDraggableInteractive(
	dragHandle: GuiObject,
	targetFrame: GuiObject,
	callbacks: {
		onSingleTap: (() -> ())?,
		onDoubleTapOrLongPress: (() -> ())?,
		onPositionChanged: ((UDim2) -> ())?,
	}
)
	local activeInput: InputObject? = nil
	local dragStart = Vector2.zero
	local startAbsPos = Vector2.zero
	local movedPastThreshold = false
	local longPressTriggered = false
	local pressGeneration = 0
	local lastTapTime = 0
	local changedConn: RBXScriptConnection? = nil
	local endedConn: RBXScriptConnection? = nil

	local function disconnectDragListeners()
		if changedConn then
			changedConn:Disconnect()
			changedConn = nil
		end
		if endedConn then
			endedConn:Disconnect()
			endedConn = nil
		end
	end

	dragHandle.InputBegan:Connect(function(input: InputObject)
		if activeInput ~= nil then
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
			activeInput = input
			dragStart = Vector2.new(input.Position.X, input.Position.Y)
			startAbsPos = targetFrame.AbsolutePosition
			movedPastThreshold = false
			longPressTriggered = false
			pressGeneration += 1
			local currentGen = pressGeneration

			if callbacks.onDoubleTapOrLongPress then
				task.delay(CONFIG.LongPressSeconds, function()
					if activeInput == input and pressGeneration == currentGen and not movedPastThreshold and not longPressTriggered then
						longPressTriggered = true
						callbacks.onDoubleTapOrLongPress()
					end
				end)
			end

			disconnectDragListeners()

			changedConn = UserInputService.InputChanged:Connect(function(changedInput: InputObject)
				if changedInput ~= activeInput then
					return
				end
				if changedInput.UserInputType == Enum.UserInputType.MouseMovement or changedInput.UserInputType == Enum.UserInputType.Touch then
					local delta = Vector2.new(changedInput.Position.X, changedInput.Position.Y) - dragStart
					if delta.Magnitude >= CONFIG.DragThresholdPixels then
						movedPastThreshold = true
					end
					if movedPastThreshold then
						local cam = getActiveCamera()
						local viewport = if cam then cam.ViewportSize else Vector2.new(1920, 1080)
						local frameSize = targetFrame.AbsoluteSize
						local clampedX = math.clamp(startAbsPos.X + delta.X, 4, math.max(4, viewport.X - frameSize.X - 4))
						local clampedY = math.clamp(startAbsPos.Y + delta.Y, 4, math.max(4, viewport.Y - frameSize.Y - 4))

						local newPos = UDim2.fromOffset(clampedX, clampedY)
						targetFrame.Position = newPos
						if callbacks.onPositionChanged then
							callbacks.onPositionChanged(newPos)
						end
					end
				end
			end)

			endedConn = UserInputService.InputEnded:Connect(function(endedInput: InputObject)
				if endedInput == activeInput then
					local wasCleanTap = (not movedPastThreshold) and (not longPressTriggered)
					activeInput = nil
					movedPastThreshold = false
					disconnectDragListeners()

					if wasCleanTap then
						local now = os.clock()
						if callbacks.onDoubleTapOrLongPress and (now - lastTapTime) <= CONFIG.DoubleTapSeconds then
							lastTapTime = 0
							callbacks.onDoubleTapOrLongPress()
						else
							lastTapTime = now
							if callbacks.onSingleTap then
								callbacks.onSingleTap()
							end
						end
					end
				end
			end)
		end
	end)
end


local function cycleManualPriorityTarget()
	local candidates: { Player } = {}
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer ~= player then
			local isEnemy = not (AIM_CONFIG.TeamCheck and player.Team ~= nil and otherPlayer.Team == player.Team)
			if isEnemy and otherPlayer.Character then
				table.insert(candidates, otherPlayer)
			end
		end
	end

	if #candidates == 0 then
		manualPriorityTarget = nil
		return
	end

	if not manualPriorityTarget then
		manualPriorityTarget = candidates[1]
		return
	end

	for idx, p in ipairs(candidates) do
		if p == manualPriorityTarget then
			if idx < #candidates then
				manualPriorityTarget = candidates[idx + 1]
			else
				manualPriorityTarget = nil
			end
			return
		end
	end

	manualPriorityTarget = candidates[1]
end

-- Safe HTTP Fetch for Server Hopping across StarterCharacterScriptss & Executors
local function fetchPublicServersJSON(placeId: number): string?
	local url = string.format("https://games.roblox.com/v1/games/%d/servers/Public?sortOrder=Asc&limit=100", placeId)

	if typeof(game.HttpGet) == "function" then
		local ok, res = pcall(function()
			return game:HttpGet(url)
		end)
		if ok and typeof(res) == "string" and #res > 0 then
			return res
		end
	end

	local reqFn = (typeof(request) == "function" and request)
		or (typeof(http_request) == "function" and http_request)
		or (typeof(syn) == "table" and typeof(syn.request) == "function" and syn.request)
		or nil

	if reqFn then
		local ok, res = pcall(function()
			return reqFn({ Url = url, Method = "GET" })
		end)
		if ok and typeof(res) == "table" and typeof(res.Body) == "string" and #res.Body > 0 then
			return res.Body
		end
	end

	return nil
end

